#. Plugin Name of the plugin
#: myplan-consent.php
msgid "MyPlan Cookie Consent"
msgstr "MyPlan Cookie Consent"

#. Description of the plugin
#: myplan-consent.php
msgid "GDPR cookie banner with Google Consent Mode v2 (advanced and basic), script and embed blocking, consent log and WP Consent API support. Translatable with gettext, WPML, Polylang and TranslatePress."
msgstr "GDPR-kompatibilis sütisáv Google Consent Mode v2-vel (advanced és basic), szkript- és beágyazásblokkolással, hozzájárulási naplóval és WP Consent API-támogatással. Fordítható gettexttel, WPML-lel, Polylanggal és TranslatePress-szel."

#. Author of the plugin
#: myplan-consent.php
msgid "MyPlan"
msgstr "MyPlan"

#: includes/class-mpc-admin.php:32
#: includes/class-mpc-admin.php:33
