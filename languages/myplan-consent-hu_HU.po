#: includes/class-mpc-admin.php:253
#, php-format
msgid "Current policy version: %d"
msgstr "Jelenlegi szabályzatverzió: %d"

#: includes/class-mpc-admin.php:276
msgid "You are not allowed to do this."
msgstr "Ehhez nincs jogosultságod."

